<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Untuk bocilnyaa kakaaa😆</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: linear-gradient(to bottom, #ffc0cb, #fff);
      overflow: hidden;
      font-family: 'Segoe UI', sans-serif;
      color: #b30059;
      text-align: center;
    }

    h1 {
      margin-top: 60px;
      font-size: 2.5em;
      animation: fadeIn 2s ease forwards;
    }

    .message {
      font-size: 1.4em;
      margin: 20px auto;
      max-width: 600px;
      opacity: 0;
      animation: fadeIn 2s ease forwards;
      animation-delay: 3s;
    }

    @keyframes fadeIn {
      to {
        opacity: 1;
      }
    }

    .heart {
      position: absolute;
      width: 20px;
      height: 20px;
      background: red;
      transform: rotate(45deg);
      animation: fall 8s linear infinite;
    }

    .heart::before,
    .heart::after {
      content: "";
      position: absolute;
      width: 20px;
      height: 20px;
      background: red;
      border-radius: 50%;
    }

    .heart::before {
      top: -10px;
      left: 0;
    }

    .heart::after {
      left: -10px;
      top: 0;
    }

    @keyframes fall {
      0% {
        transform: translateY(-100px) rotate(45deg);
        opacity: 1;
      }
      100% {
        transform: translateY(100vh) rotate(45deg);
        opacity: 0;
      }
    }
  </style>
</head>
<body>
  <h1>Halooo sayaangggg🙌</h1>
  <div class="message" id="msg"></div>

  <script>
    const messages = [
      "Semangat olwess yaa ngejalanin kegiatannyaaa",
      "Kakaa tau pasti adee bisaaa",
      "Kakaa juga tauuu meski adee masii bocilll tapi adee tuu kuattt",
      "Tapi don forget untuk istirahat jugaa yaaa",
      "Kakaa sayang adeeee🫶🩶",
      "Ini khusus aku buat untuk adeee",
      "Karna adee sangat spesial dihati kakaaa😍"
    ];

    let i = 0;
    const msgDiv = document.getElementById('msg');

    function showMessage() {
      if (i < messages.length) {
        const p = document.createElement('p');
        p.textContent = messages[i];
        p.style.opacity = 0;
        p.style.transition = "opacity 1s ease";
        msgDiv.appendChild(p);
        setTimeout(() => p.style.opacity = 1, 100);
        i++;
        setTimeout(showMessage, 3000);
      }
    }

    showMessage();

    // Generate hearts
    setInterval(() => {
      const heart = document.createElement("div");
      heart.className = "heart";
      heart.style.left = Math.random() * 100 + "vw";
      heart.style.animationDuration = (4 + Math.random() * 4) + "s";
      document.body.appendChild(heart);
      setTimeout(() => heart.remove(), 8000);
    }, 300);
  </script>
</body>
</html>
